{
  "name": "xtreemze-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "biome check vite.config.mjs playwright.config.mjs tests scripts package.json biome.json",
    "lint:fix": "biome check --write vite.config.mjs playwright.config.mjs tests scripts package.json biome.json",
    "test": "pnpm build && playwright test",
    "test:chromium": "pnpm build && playwright test --project=chromium",
    "check": "pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "vite": "8.2.2"
  }
}
