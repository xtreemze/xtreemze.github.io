---
import { getCollection } from "astro:content";
import SourceDocument from "../../components/SourceDocument.astro";
import { renderSourceDocument } from "../../lib/source-pages";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (left, right) => left.data.sortOrder - right.data.sortOrder,
  );

  return projects.map(({ data }) => ({
    params: { slug: data.slug },
    props: { pagePath: data.sourcePath },
  }));
}

interface Props {
  pagePath: string;
}

const { pagePath } = Astro.props;
const document = await renderSourceDocument(pagePath, "en");
---

<SourceDocument {document} />
