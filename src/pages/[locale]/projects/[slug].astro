---
import { getCollection } from "astro:content";
import SourceDocument from "../../../components/SourceDocument.astro";
import {
  renderSourceDocument,
  translatedLocales,
  type SupportedLocale,
} from "../../../lib/source-pages";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (left, right) => left.data.sortOrder - right.data.sortOrder,
  );

  return translatedLocales.flatMap((locale) =>
    projects.map(({ data }) => ({
      params: { locale, slug: data.slug },
      props: {
        locale,
        pagePath: data.sourcePath,
      },
    })),
  );
}

interface Props {
  locale: SupportedLocale;
  pagePath: string;
}

const { locale, pagePath } = Astro.props;
const document = await renderSourceDocument(pagePath, locale);
---

<SourceDocument {document} />
