{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "astro.config.mjs",
      "playwright.config.mjs",
      "scripts/**/*.mjs",
      "src/**/*.ts",
      "tests/**/*.mjs",
      "public/**/*.css",
      "package.json",
      "biome.json",
      "config/**/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "complexity": {
        "noImportantStyles": "off"
      }
    },
    "domains": {
      "project": "all",
      "test": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
